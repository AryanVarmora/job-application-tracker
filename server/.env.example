DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinel?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

# AI provider for job-description analysis.
# - Local dev: leave unset. Defaults to Ollama, no API key needed.
# - Production: set NODE_ENV=production (or AI_PROVIDER=gemini explicitly) and
#   provide GEMINI_API_KEY. AI_PROVIDER overrides NODE_ENV when both are set.
# AI_PROVIDER="ollama" # "ollama" | "gemini"

# Ollama (local dev) — defaults assume `ollama serve` with the model pulled
# (`ollama pull llama3.1:8b`). No API key needed.
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="llama3.1:8b"

# Gemini (production) — free tier. Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-3.6-flash"

# Gmail read-only integration (rejection/status auto-detection) — create an OAuth 2.0 Client
# ID at https://console.cloud.google.com/apis/credentials with the Gmail API enabled, and set
# the redirect URI there to match GOOGLE_REDIRECT_URI below.
# GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="your-client-secret"
# GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"
