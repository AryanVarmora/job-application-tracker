generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  applied
  interviewing
  rejected
  offer
}

enum OutreachPlatform {
  linkedin
  email
  other
}

model Company {
  id           String        @id @default(uuid())
  name         String        @unique
  industry     String?
  size         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  @@map("companies")
}

model Application {
  id            String            @id @default(uuid())
  company       Company           @relation(fields: [companyId], references: [id])
  companyId     String
  role          String
  status        ApplicationStatus @default(applied)
  appliedDate   DateTime
  jobUrl        String?
  resumeVariant String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  contacts      Contact[]

  // Set whenever `status` actually changes value (see PATCH /applications/:id).
  // Powers GET /digest/today's "rejected today" count without a full history table.
  statusChangedAt DateTime?

  // Gates the "Analyze fit with AI" flow (POST /applications/:id/analyze). Defaults
  // off so a new application never triggers AI processing unless explicitly opted in.
  analyzeEnabled Boolean @default(false)

  // AI job-description analysis (populated by POST /applications/:id/analyze)
  jobDescriptionText       String?
  extractedRequiredSkills  Json?
  extractedPreferredSkills Json?
  seniorityLevel           String?
  roleSummary              String?
  fitScore                 Int?
  matchBreakdown           Json?
  analyzedAt               DateTime?

  outreachContacts OutreachContact[]

  @@map("applications")
}

// A logged LinkedIn DM / cold email, independent of the Application pipeline. Deleting
// the linked Application (if any) unlinks rather than cascades, since the outreach log
// entry is meaningful on its own. See services/outreachExpiry.ts for the 7-day cleanup.
model OutreachContact {
  id                  String           @id @default(uuid())
  personName          String
  company             String?
  platform            OutreachPlatform
  messagedAt          DateTime         @default(now())
  isLead              Boolean          @default(false)
  notes               String?
  linkedApplication   Application?     @relation(fields: [linkedApplicationId], references: [id], onDelete: SetNull)
  linkedApplicationId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("outreach_contacts")
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  category   String?
  createdAt  DateTime    @default(now())
  userSkill  UserSkill?

  @@map("skills")
}

model UserSkill {
  id              String   @id @default(uuid())
  skill           Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId         String   @unique
  proficiency     String?
  yearsExperience Float?
  createdAt       DateTime @default(now())

  @@map("user_skills")
}

model Contact {
  id            String       @id @default(uuid())
  name          String
  role          String?
  email         String?
  linkedinUrl   String?
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("contacts")
}
