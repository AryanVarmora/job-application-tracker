generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  applied
  interviewing
  rejected
  offer
}

enum OutreachPlatform {
  linkedin
  email
  other
}

enum EmailConfidence {
  high
  medium
  low
}

enum GmailSuggestionType {
  status_update
  new_application
}

model Company {
  id           String        @id @default(uuid())
  name         String        @unique
  industry     String?
  size         String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  applications Application[]

  @@map("companies")
}

model Application {
  id            String            @id @default(uuid())
  company       Company           @relation(fields: [companyId], references: [id])
  companyId     String
  role          String
  status        ApplicationStatus @default(applied)
  appliedDate   DateTime
  jobUrl        String?
  resumeVariant String?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  contacts      Contact[]

  // Locally-stored resume file (see services/resumeStorage.ts + resumeExpiry.ts). Path is
  // relative to the uploads/resumes directory, not an absolute filesystem path, so the
  // stored value stays portable across deploys and doesn't leak server directory layout
  // through the API. Auto-expires 30 days after upload via the same check-on-read pattern
  // as OutreachContact's 7-day expiry.
  resumeFilePath       String?
  resumeFileUploadedAt DateTime?

  // Set whenever `status` actually changes value (see PATCH /applications/:id).
  // Powers GET /digest/today's "rejected today" count without a full history table.
  statusChangedAt DateTime?

  // Gates the "Analyze fit with AI" flow (POST /applications/:id/analyze). Defaults
  // off so a new application never triggers AI processing unless explicitly opted in.
  analyzeEnabled Boolean @default(false)

  // AI job-description analysis (populated by POST /applications/:id/analyze)
  jobDescriptionText       String?
  extractedRequiredSkills  Json?
  extractedPreferredSkills Json?
  seniorityLevel           String?
  roleSummary              String?
  fitScore                 Int?
  matchBreakdown           Json?
  analyzedAt               DateTime?

  outreachContacts OutreachContact[]
  gmailSuggestions GmailSuggestion[]

  @@map("applications")
}

// A logged LinkedIn DM / cold email, independent of the Application pipeline. Deleting
// the linked Application (if any) unlinks rather than cascades, since the outreach log
// entry is meaningful on its own. See services/outreachExpiry.ts for the 7-day cleanup.
model OutreachContact {
  id                  String           @id @default(uuid())
  personName          String
  company             String?
  platform            OutreachPlatform
  messagedAt          DateTime         @default(now())
  isLead              Boolean          @default(false)
  notes               String?
  linkedApplication   Application?     @relation(fields: [linkedApplicationId], references: [id], onDelete: SetNull)
  linkedApplicationId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@map("outreach_contacts")
}

model Skill {
  id         String      @id @default(uuid())
  name       String      @unique
  category   String?
  createdAt  DateTime    @default(now())
  userSkill  UserSkill?

  @@map("skills")
}

model UserSkill {
  id              String   @id @default(uuid())
  skill           Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId         String   @unique
  proficiency     String?
  yearsExperience Float?
  createdAt       DateTime @default(now())

  @@map("user_skills")
}

// Stores the single-user Gmail OAuth refresh token (see services/googleAuth.ts). One row
// is expected; access tokens are never persisted since google-auth-library derives a fresh
// one from the refresh token on demand.
model GoogleAuthToken {
  id           String   @id @default(uuid())
  refreshToken String
  createdAt    DateTime @default(now())

  @@map("google_auth_tokens")
}

// Singleton row tracking Gmail scan progress (see services/gmailScan.ts), so POST /gmail/scan
// only asks Gmail for messages since the last successful scan (bounded to the last 7 days)
// instead of re-fetching the same window on every call.
model GmailScanState {
  id            String    @id @default(uuid())
  lastScannedAt DateTime?

  @@map("gmail_scan_state")
}

// Records that a Gmail message has already been considered by a scan, regardless of outcome
// (auto-applied, turned into a GmailSuggestion, or ignored as not job-related) - the single
// source of truth for "don't reprocess this", independent of whether a GmailSuggestion row
// for it still exists (it's deleted on confirm/reject, this row is not).
model GmailProcessedMessage {
  id             String   @id @default(uuid())
  gmailMessageId String   @unique
  processedAt    DateTime @default(now())

  @@map("gmail_processed_messages")
}

// A medium/low-confidence guess extracted from a scanned email, awaiting the user's
// confirm/reject via POST/DELETE /gmail/suggestions/:id (same confirm-before-anything-changes
// contract as the manual paste-email flow). High-confidence matches are applied/created
// directly by the scan and never create a row here.
//
// Two shapes share this table, discriminated by `type`:
// - status_update: a status change for an EXISTING tracked application (applicationId +
//   suggestedStatus are set; companyName/role/appliedDate are null).
// - new_application: no existing tracked application matched, but the email reads like a
//   genuine "you just applied" confirmation (companyName/role/appliedDate are set;
//   applicationId/suggestedStatus are null - there's nothing existing to reference yet).
model GmailSuggestion {
  id              String              @id @default(uuid())
  gmailMessageId  String              @unique
  type            GmailSuggestionType @default(status_update)
  confidence      EmailConfidence
  createdAt       DateTime            @default(now())

  // status_update fields
  application     Application?        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId   String?
  suggestedStatus ApplicationStatus?

  // new_application fields
  companyName String?
  role        String?
  appliedDate DateTime?

  @@map("gmail_suggestions")
}

model Contact {
  id            String       @id @default(uuid())
  name          String
  role          String?
  email         String?
  linkedinUrl   String?
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("contacts")
}
